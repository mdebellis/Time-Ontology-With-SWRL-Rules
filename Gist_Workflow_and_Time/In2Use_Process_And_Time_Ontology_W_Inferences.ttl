###  http://www.w3.org/2006/time#July_4_1946
<http://www.w3.org/2006/time#July_4_1946> rdf:type owl:NamedIndividual ,
                                                   <http://www.w3.org/2006/time#Instant> ,
                                                   <http://www.w3.org/2006/time#TemporalEntity> ;
                                          <http://www.w3.org/2006/time#after> <http://www.w3.org/2006/time#April_12_1861> ,
                                                                              <http://www.w3.org/2006/time#August_7_1945> ,
                                                                              <http://www.w3.org/2006/time#July_1_1863> ,
                                                                              <http://www.w3.org/2006/time#July_3_1863> ,
                                                                              <http://www.w3.org/2006/time#June_25_1940> ,
