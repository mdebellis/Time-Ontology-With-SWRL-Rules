[ rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> <http://www.w3.org/2006/time#before> ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> <urn:swrl:var#t2fi> ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> <urn:swrl:var#t1li>
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#propertyPredicate> <http://www.w3.org/2006/time#before> ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> <urn:swrl:var#t1fi> ;
                                                                  <http://www.w3.org/2003/11/swrl#argument2> <urn:swrl:var#t2fi>
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#propertyPredicate> <http://www.w3.org/2006/time#hasBeginning> ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> <urn:swrl:var#tInterval2> ;
                                                                             <http://www.w3.org/2003/11/swrl#argument2> <urn:swrl:var#t2fi>
                                                                           ] ;
                                                                 rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                            rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                                        <http://www.w3.org/2003/11/swrl#propertyPredicate> <http://www.w3.org/2006/time#before> ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument1> <urn:swrl:var#t1li> ;
                                                                                        <http://www.w3.org/2003/11/swrl#argument2> <urn:swrl:var#t2li>
                                                                                      ] ;
                                                                            rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                                       rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
