                                                                                       "一周"@zh ,
                                                                                       "一週間"@jp ,
                                                                                       "일주일"@kr .


###  http://www.w3.org/2006/time#unitYear
<http://www.w3.org/2006/time#unitYear> rdf:type owl:NamedIndividual ,
                                                <http://www.w3.org/2006/time#GeneralDurationDescription> ,
                                                <http://www.w3.org/2006/time#TemporalDuration> ,
                                                <http://www.w3.org/2006/time#TemporalUnit> ;
                                       <http://www.w3.org/2006/time#days> 0 ;
                                       <http://www.w3.org/2006/time#hours> 0 ;
                                       <http://www.w3.org/2006/time#minutes> 0 ;
                                       <http://www.w3.org/2006/time#months> 0 ;
                                       <http://www.w3.org/2006/time#seconds> 0 ;
                                       <http://www.w3.org/2006/time#weeks> 0 ;
                                       <http://www.w3.org/2006/time#years> 1 ;
                                       rdfs:label "Year (unit of temporal duration)"@en ;
                                       <http://www.w3.org/2004/02/skos/core#prefLabel> "1 년"@kr ,
                                                                                       "1年"@jp ,
                                                                                       "Jahr"@de ,
                                                                                       "an"@fr ,
                                                                                       "anno"@it ,
                                                                                       "ano"@pt ,
                                                                                       "jaar"@nl ,
                                                                                       "rok"@pl ,
                                                                                       "un año"@es ,
                                                                                       "year"@en ,
                                                                                       "один год"@ru ,
                                                                                       "سنة واحدة"@ar ,
                                                                                       "一年"@zh .


