# Minimal input for the SPARQL demonstration.
# Adapted from Michael DeBellis's asserted Process_And_Time.ttl example.
# Same templates, goals, person, project, endpoint nodes, and dates.
# Task IRIs follow 01_generate_tasks.ru's deterministic naming convention.
# Their measured dates/participants are inputs; task types, template/project
# links, goals, labels, and ordering will be generated by the update.
# This is demonstration data for a completed fictional project. No dates
# or completion facts have been inferred from the reusable templates.

@prefix gist: <https://w3id.org/semanticarts/ns/ontology/gist/> .
@prefix graph: <https://www.in2use.com/process-time/graph/> .
@prefix ipt: <https://www.in2use.com/process-time/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

graph:source {
    ipt:AlexOnboardingProject a owl:NamedIndividual,
            gist:Project,
            gist:Task ;
        rdfs:label "Alex onboarding project — 5 October 2026"@en ;
        skos:prefLabel "Alex onboarding project — 5 October 2026"@en ;
        time:hasBeginning ipt:Instant_2026_10_05_0900_PDT ;
        time:hasEnd ipt:Instant_2026_10_05_1700_PDT ;
        gist:actualEndMinute "2026-10-05T17:00:00-07:00"^^xsd:dateTime ;
        gist:actualStartMinute "2026-10-05T09:00:00-07:00"^^xsd:dateTime ;
        gist:hasGoal ipt:AlexOnboardingGoal ;
        gist:hasParticipant ipt:AlexExample ;
        gist:isBasedOn ipt:EmployeeOnboardingTemplate .

    <https://www.in2use.com/process-time/AlexOnboardingProject/task/07a08561ad1d65d2419749199aaa84930d25a3ea3249423c7427dc9fad766957> time:hasBeginning ipt:Instant_2026_10_05_0900_PDT ;
        time:hasEnd ipt:Instant_2026_10_05_0930_PDT ;
        gist:actualEndMinute "2026-10-05T09:30:00-07:00"^^xsd:dateTime ;
        gist:actualStartMinute "2026-10-05T09:00:00-07:00"^^xsd:dateTime ;
        gist:hasParticipant ipt:AlexExample .

    <https://www.in2use.com/process-time/AlexOnboardingProject/task/210fef2b81c989df95d9a5e5236566a61074f36c9582beff865ff335247e23ee> time:hasBeginning ipt:Instant_2026_10_05_1300_PDT ;
        time:hasEnd ipt:Instant_2026_10_05_1600_PDT ;
        gist:actualEndMinute "2026-10-05T16:00:00-07:00"^^xsd:dateTime ;
        gist:actualStartMinute "2026-10-05T13:00:00-07:00"^^xsd:dateTime ;
        gist:hasParticipant ipt:AlexExample .

    <https://www.in2use.com/process-time/AlexOnboardingProject/task/43b800af5f5bd1138a178697925bef19256c11f8e64bdadd42abf3ce49dbfe24> time:hasBeginning ipt:Instant_2026_10_05_1600_PDT ;
        time:hasEnd ipt:Instant_2026_10_05_1700_PDT ;
        gist:actualEndMinute "2026-10-05T17:00:00-07:00"^^xsd:dateTime ;
        gist:actualStartMinute "2026-10-05T16:00:00-07:00"^^xsd:dateTime ;
        gist:hasParticipant ipt:AlexExample .

    <https://www.in2use.com/process-time/AlexOnboardingProject/task/7c1f1a7fdc1e45e0affafc98eea0b9edd2d8437149dede8b9225e3079cc1c02b> time:hasBeginning ipt:Instant_2026_10_05_1130_PDT ;
        time:hasEnd ipt:Instant_2026_10_05_1230_PDT ;
        gist:actualEndMinute "2026-10-05T12:30:00-07:00"^^xsd:dateTime ;
        gist:actualStartMinute "2026-10-05T11:30:00-07:00"^^xsd:dateTime ;
        gist:hasParticipant ipt:AlexExample .

    <https://www.in2use.com/process-time/AlexOnboardingProject/task/8092507289a3a8e23e0c2314bf95c103602a49705b6341983e2406631f743db9> time:hasBeginning ipt:Instant_2026_10_05_0930_PDT ;
        time:hasEnd ipt:Instant_2026_10_05_1100_PDT ;
        gist:actualEndMinute "2026-10-05T11:00:00-07:00"^^xsd:dateTime ;
        gist:actualStartMinute "2026-10-05T09:30:00-07:00"^^xsd:dateTime ;
        gist:hasParticipant ipt:AlexExample .

    <https://www.in2use.com/process-time/AlexOnboardingProject/task/891b8da041c64eee0c55daeaa8e321e2d522de8b0eb35d0619b8f0fa39cc6169> time:hasBeginning ipt:Instant_2026_10_05_1300_PDT ;
        time:hasEnd ipt:Instant_2026_10_05_1600_PDT ;
        gist:actualEndMinute "2026-10-05T16:00:00-07:00"^^xsd:dateTime ;
        gist:actualStartMinute "2026-10-05T13:00:00-07:00"^^xsd:dateTime ;
        gist:hasParticipant ipt:AlexExample .

    <https://www.in2use.com/process-time/AlexOnboardingProject/task/b1f2739827985a3a2cc235bce0eafde564a934184cdf4100041277c6e50b16bc> time:hasBeginning ipt:Instant_2026_10_05_1000_PDT ;
        time:hasEnd ipt:Instant_2026_10_05_1130_PDT ;
        gist:actualEndMinute "2026-10-05T11:30:00-07:00"^^xsd:dateTime ;
        gist:actualStartMinute "2026-10-05T10:00:00-07:00"^^xsd:dateTime ;
        gist:hasParticipant ipt:AlexExample .

    ipt:CollectInformationTemplate a owl:NamedIndividual,
            gist:TaskTemplate ;
        rdfs:label "Collect employee information — template"@en ;
        rdfs:comment "The information needed to onboard the employee is available."@en ;
        skos:prefLabel "Collect employee information — template"@en ;
        gist:hasGoal ipt:CollectInformationGoal ;
        gist:isPartOf ipt:EmployeeOnboardingTemplate ;
        gist:precedes ipt:ConfigureAccountsTemplate,
            ipt:HROrientationTemplate,
            ipt:PrepareComputerTemplate .

    ipt:AlexOnboardingGoal a owl:NamedIndividual,
            gist:Intention ;
        rdfs:label "Alex ready to begin work"@en ;
        skos:prefLabel "Alex ready to begin work"@en ;
        gist:isBasedOn ipt:OnboardingGoal .

    ipt:BuddySupportGoal a owl:NamedIndividual,
            gist:Intention ;
        rdfs:label "Provide onboarding buddy support — intended outcome"@en ;
        rdfs:comment "The employee has a colleague available throughout technical training."@en ;
        skos:prefLabel "Provide onboarding buddy support — intended outcome"@en .

    ipt:CollectInformationGoal a owl:NamedIndividual,
            gist:Intention ;
        rdfs:label "Collect employee information — intended outcome"@en ;
        rdfs:comment "The information needed to onboard the employee is available."@en ;
        skos:prefLabel "Collect employee information — intended outcome"@en .

    ipt:ConfigureAccountsGoal a owl:NamedIndividual,
            gist:Intention ;
        rdfs:label "Configure accounts — intended outcome"@en ;
        rdfs:comment "The employee can sign in to the required systems."@en ;
        skos:prefLabel "Configure accounts — intended outcome"@en .

    ipt:ConfigureAccountsTemplate a owl:NamedIndividual,
            gist:TaskTemplate ;
        rdfs:label "Configure accounts — template"@en ;
        rdfs:comment "The employee can sign in to the required systems."@en ;
        skos:prefLabel "Configure accounts — template"@en ;
        gist:hasGoal ipt:ConfigureAccountsGoal ;
        gist:isPartOf ipt:EmployeeOnboardingTemplate ;
        gist:precedes ipt:BuddySupportTemplate,
            ipt:TechnicalTrainingTemplate .

    ipt:FinalReviewGoal a owl:NamedIndividual,
            gist:Intention ;
        rdfs:label "Complete the onboarding review — intended outcome"@en ;
        rdfs:comment "The employee and reviewer have confirmed readiness to begin work."@en ;
        skos:prefLabel "Complete the onboarding review — intended outcome"@en .

    ipt:HROrientationGoal a owl:NamedIndividual,
            gist:Intention ;
        rdfs:label "Conduct HR orientation — intended outcome"@en ;
        rdfs:comment "The employee understands the essential employment policies."@en ;
        skos:prefLabel "Conduct HR orientation — intended outcome"@en .

    ipt:HROrientationTemplate a owl:NamedIndividual,
            gist:TaskTemplate ;
        rdfs:label "Conduct HR orientation — template"@en ;
        rdfs:comment "The employee understands the essential employment policies."@en ;
        skos:prefLabel "Conduct HR orientation — template"@en ;
        gist:hasGoal ipt:HROrientationGoal ;
        gist:isPartOf ipt:EmployeeOnboardingTemplate ;
        gist:precedes ipt:BuddySupportTemplate,
            ipt:TechnicalTrainingTemplate .

    ipt:Instant_2026_10_05_1000_PDT a owl:NamedIndividual,
            time:Instant ;
        rdfs:label "5 October 2026 10:00 UTC-07:00"@en ;
        skos:prefLabel "5 October 2026 10:00 UTC-07:00"@en ;
        time:inXSDDateTimeStamp "2026-10-05T10:00:00-07:00"^^xsd:dateTimeStamp .

    ipt:Instant_2026_10_05_1100_PDT a owl:NamedIndividual,
            time:Instant ;
        rdfs:label "5 October 2026 11:00 UTC-07:00"@en ;
        skos:prefLabel "5 October 2026 11:00 UTC-07:00"@en ;
        time:inXSDDateTimeStamp "2026-10-05T11:00:00-07:00"^^xsd:dateTimeStamp .

    ipt:Instant_2026_10_05_1230_PDT a owl:NamedIndividual,
            time:Instant ;
        rdfs:label "5 October 2026 12:30 UTC-07:00"@en ;
        skos:prefLabel "5 October 2026 12:30 UTC-07:00"@en ;
        time:inXSDDateTimeStamp "2026-10-05T12:30:00-07:00"^^xsd:dateTimeStamp .

    ipt:PrepareComputerGoal a owl:NamedIndividual,
            gist:Intention ;
        rdfs:label "Prepare the computer — intended outcome"@en ;
        rdfs:comment "The employee has a configured computer ready for use."@en ;
        skos:prefLabel "Prepare the computer — intended outcome"@en .

    ipt:PrepareComputerTemplate a owl:NamedIndividual,
            gist:TaskTemplate ;
        rdfs:label "Prepare the computer — template"@en ;
        rdfs:comment "The employee has a configured computer ready for use."@en ;
        skos:prefLabel "Prepare the computer — template"@en ;
        gist:hasGoal ipt:PrepareComputerGoal ;
        gist:isPartOf ipt:EmployeeOnboardingTemplate ;
        gist:precedes ipt:BuddySupportTemplate,
            ipt:TechnicalTrainingTemplate .

    ipt:TechnicalTrainingGoal a owl:NamedIndividual,
            gist:Intention ;
        rdfs:label "Conduct technical training — intended outcome"@en ;
        rdfs:comment "The employee can carry out the introductory technical exercises."@en ;
        skos:prefLabel "Conduct technical training — intended outcome"@en .

    ipt:FinalReviewTemplate a owl:NamedIndividual,
            gist:TaskTemplate ;
        rdfs:label "Complete the onboarding review — template"@en ;
        rdfs:comment "The employee and reviewer have confirmed readiness to begin work."@en ;
        skos:prefLabel "Complete the onboarding review — template"@en ;
        gist:hasGoal ipt:FinalReviewGoal ;
        gist:isPartOf ipt:EmployeeOnboardingTemplate .

    ipt:Instant_2026_10_05_0900_PDT a owl:NamedIndividual,
            time:Instant ;
        rdfs:label "5 October 2026 09:00 UTC-07:00"@en ;
        skos:prefLabel "5 October 2026 09:00 UTC-07:00"@en ;
        time:inXSDDateTimeStamp "2026-10-05T09:00:00-07:00"^^xsd:dateTimeStamp .

    ipt:Instant_2026_10_05_0930_PDT a owl:NamedIndividual,
            time:Instant ;
        rdfs:label "5 October 2026 09:30 UTC-07:00"@en ;
        skos:prefLabel "5 October 2026 09:30 UTC-07:00"@en ;
        time:inXSDDateTimeStamp "2026-10-05T09:30:00-07:00"^^xsd:dateTimeStamp .

    ipt:Instant_2026_10_05_1130_PDT a owl:NamedIndividual,
            time:Instant ;
        rdfs:label "5 October 2026 11:30 UTC-07:00"@en ;
        skos:prefLabel "5 October 2026 11:30 UTC-07:00"@en ;
        time:inXSDDateTimeStamp "2026-10-05T11:30:00-07:00"^^xsd:dateTimeStamp .

    ipt:Instant_2026_10_05_1300_PDT a owl:NamedIndividual,
            time:Instant ;
        rdfs:label "5 October 2026 13:00 UTC-07:00"@en ;
        skos:prefLabel "5 October 2026 13:00 UTC-07:00"@en ;
        time:inXSDDateTimeStamp "2026-10-05T13:00:00-07:00"^^xsd:dateTimeStamp .

    ipt:Instant_2026_10_05_1700_PDT a owl:NamedIndividual,
            time:Instant ;
        rdfs:label "5 October 2026 17:00 UTC-07:00"@en ;
        skos:prefLabel "5 October 2026 17:00 UTC-07:00"@en ;
        time:inXSDDateTimeStamp "2026-10-05T17:00:00-07:00"^^xsd:dateTimeStamp .

    ipt:OnboardingGoal a owl:NamedIndividual,
            gist:Intention ;
        rdfs:label "Employee ready to begin work"@en ;
        skos:prefLabel "Employee ready to begin work"@en .

    ipt:BuddySupportTemplate a owl:NamedIndividual,
            gist:TaskTemplate ;
        rdfs:label "Provide onboarding buddy support — template"@en ;
        rdfs:comment "The employee has a colleague available throughout technical training."@en ;
        skos:prefLabel "Provide onboarding buddy support — template"@en ;
        gist:hasGoal ipt:BuddySupportGoal ;
        gist:isPartOf ipt:EmployeeOnboardingTemplate ;
        gist:precedes ipt:FinalReviewTemplate .

    ipt:Instant_2026_10_05_1600_PDT a owl:NamedIndividual,
            time:Instant ;
        rdfs:label "5 October 2026 16:00 UTC-07:00"@en ;
        skos:prefLabel "5 October 2026 16:00 UTC-07:00"@en ;
        time:inXSDDateTimeStamp "2026-10-05T16:00:00-07:00"^^xsd:dateTimeStamp .

    ipt:TechnicalTrainingTemplate a owl:NamedIndividual,
            gist:TaskTemplate ;
        rdfs:label "Conduct technical training — template"@en ;
        rdfs:comment "The employee can carry out the introductory technical exercises."@en ;
        skos:prefLabel "Conduct technical training — template"@en ;
        gist:hasGoal ipt:TechnicalTrainingGoal ;
        gist:isPartOf ipt:EmployeeOnboardingTemplate ;
        gist:precedes ipt:FinalReviewTemplate .

    ipt:AlexExample a owl:NamedIndividual,
            gist:Person ;
        rdfs:label "Alex Example (fictional employee)"@en ;
        rdfs:comment "A fictional participant used only for this onboarding demonstration."@en ;
        skos:prefLabel "Alex Example (fictional employee)"@en .

    ipt:EmployeeOnboardingTemplate a owl:NamedIndividual,
            gist:TaskTemplate ;
        rdfs:label "Employee onboarding template"@en ;
        rdfs:comment "Reusable process definition. Its component task templates are connected to it by gist:isPartOf. gist:precedes records the intended partial ordering of steps. In this example the listed predecessor must finish no later than the successor starts. These requirements are not OWL-Time relations, and gist:precedes alone does not enforce this scheduling convention or generate task instances."@en ;
        skos:prefLabel "Employee onboarding template"@en ;
        gist:hasGoal ipt:OnboardingGoal .
}

